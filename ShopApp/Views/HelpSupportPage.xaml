<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.HelpSupportPage"
             xmlns:views="clr-namespace:ShopApp.Views"
             Title="HelpSupportPage">

    <ContentPage.BindingContext>
        <views:HelpSupportData VisitasPendientes="5"/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Label Text="{Binding VisitasPendientes, Mode=OneWay}" />

        <Button Grid.Row="1" Text="Actualizar" Clicked="Button_Clicked" />

        <Label Grid.Row="2" Text="{Binding Clients.Count, Mode=OneWay}" FontSize="30" />

        <CollectionView
            Grid.Row="3"
            SelectionMode="Single"
            SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
            ItemsSource="{Binding Clients, Mode=OneWay}" />
    </Grid>

</ContentPage>